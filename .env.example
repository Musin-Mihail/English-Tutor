# AI provider: cursor (default) or gemini
AI_PROVIDER=cursor

# Cursor SDK (required when AI_PROVIDER=cursor)
# Get key: https://cursor.com/dashboard/integrations
CURSOR_API_KEY=your_cursor_api_key_here
CURSOR_MODEL=composer-2.5

# Google Gemini (required when AI_PROVIDER=gemini)
# GOOGLE_API_KEY=your_google_api_key_here
# GEMINI_MODEL=gemini-3-flash-preview

# Local speech recognition (GPU via CUDA when available)
WHISPER_MODEL=large-v3
ASR_DEVICE=auto
ASR_COMPUTE_TYPE=auto
# Download/cache dir (default: app/data/whisper_models)
# ASR_DOWNLOAD_ROOT=
# Preload Whisper at server start (recommended)
ASR_PRELOAD=true

# Uncomment and set if you need a proxy for Gemini (e.g. http://127.0.0.1:12334)
# PROXY_URL=
